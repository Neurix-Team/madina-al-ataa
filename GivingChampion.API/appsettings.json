{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "GivingChampion",
    "Audience": "GivingChampion.Client",
    "AccessTokenMinutes": 60,
    "Key": "This value will be overridden by User Secrets / Environment Variables"
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "This will be overridden by User Secrets / Environment Variables"
    }
  },
  "Frontend": {
    "AuthCallbackUrl": "http://localhost:5173/auth/callback"
  }
}
