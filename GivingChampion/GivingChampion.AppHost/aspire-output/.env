# Container image name for api
API_IMAGE=registry.example.com/team/givingchampion-api:latest

# Default container port for api
API_PORT=

# Parameter auth-callback-url
AUTH_CALLBACK_URL=

# Parameter cors-origins
CORS_ORIGINS=

# Parameter DefaultConnection
DEFAULTCONNECTION=

# Parameter google-client-id
GOOGLE_CLIENT_ID=

# Parameter google-client-secret
GOOGLE_CLIENT_SECRET=

# Parameter jwt-access-token-minutes
JWT_ACCESS_TOKEN_MINUTES=

# Parameter jwt-audience
JWT_AUDIENCE=

# Parameter jwt-issuer
JWT_ISSUER=

# Parameter jwt-key
JWT_KEY=

# Container image name for migrator
MIGRATOR_IMAGE=registry.example.com/team/givingchampion-migrator:latest

# Container image name for seeder
SEEDER_IMAGE=registry.example.com/team/givingchampion-seeder:latest

# Parameter registry-endpoint
REGISTRY_ENDPOINT=registry.example.com

# Parameter registry-repository
REGISTRY_REPOSITORY=team

